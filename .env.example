# Local demo. Set prod for a public Telegram deployment.
mode=demo
PORT=8080
SCHEDULE_SOURCE=demo

# Create a strong password before initializing a production database.
POSTGRES_DB=schvopsel
POSTGRES_USER=schvopsel
POSTGRES_PASSWORD=local-demo

# Configure these for the Telegram bot and production Mini App.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
MAIN_ADMIN_TELEGRAM_ID=

# Configure these to enable the schedule worker.
GEMINI_API_KEY=
# Optional comma-separated OCR model override. Empty uses the built-in order.
GEMINI_MODELS=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./channel_listener.session
CHANNEL_USERNAME=
CHANNEL_TARGET=
TARGET_GROUP=99А

# Optional, standalone Caddy.
CADDY_SITE_ADDRESS=http://localhost
CADDY_BIND=127.0.0.1
CADDY_HTTP_PORT=8081
CADDY_HTTPS_PORT=8443

# Optional, existing Caddy on the same Docker host.
CADDY_EXTERNAL_NETWORK=example-edge-network
